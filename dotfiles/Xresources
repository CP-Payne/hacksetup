! xterm stays simple, tmux does the tab and pane management.
! Loaded by ~/.xprofile at login. Reload with: xrdb -merge ~/.Xresources
XTerm*termName:          xterm-256color
XTerm*locale:            true
XTerm*faceName:          JetBrains Mono
XTerm*faceSize:          11
XTerm*saveLines:         10000
XTerm*scrollBar:         false
XTerm*internalBorder:    4

! Without this, Alt+1 to 9 never reach tmux
XTerm*metaSendsEscape:   true

! Copy on select, plus the usual terminal copy and paste keys
XTerm*selectToClipboard: true
XTerm*vt100.translations: #override \n\
  Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
  Ctrl Shift <Key>V: insert-selection(CLIPBOARD)

! Dark theme. The default blue is unreadable on a dark background.
XTerm*background:  #1c1c1c
XTerm*foreground:  #d0d0d0
XTerm*cursorColor: #d0d0d0
XTerm*color0:      #2e2e2e
XTerm*color1:      #e06c75
XTerm*color2:      #98c379
XTerm*color3:      #e5c07b
XTerm*color4:      #61afef
XTerm*color5:      #c678dd
XTerm*color6:      #56b6c2
XTerm*color7:      #d0d0d0
XTerm*color8:      #5c6370
